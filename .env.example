# Flask Application Configuration
FLASK_APP=app.py
FLASK_ENV=development
# Change to 'production' when deploying

# Secret Key for Session Management
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# IMPORTANT: Change this in production!
SECRET_KEY=dev-secret-key-change-in-production

# Database Configuration
# Development (SQLite)
DATABASE_URL=sqlite:///family.db

# Production (PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/family_tree

# Server Configuration
DEBUG=True  # Set to False in production
PORT=5000
HOST=0.0.0.0

# Email Configuration (Optional, for future features)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password

# File Upload Configuration
MAX_CONTENT_LENGTH=16777216  # 16 MB in bytes
UPLOAD_FOLDER=static/uploads

# Session Configuration
SESSION_COOKIE_SECURE=False  # Set to True in production with HTTPS
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Redis Configuration (Optional, for caching)
# REDIS_URL=redis://localhost:6379/0

# Sentry Configuration (Optional, for error tracking)
# SENTRY_DSN=your-sentry-dsn-here

# External APIs (Optional, for future integrations)
# GOOGLE_MAPS_API_KEY=your-google-maps-key
# SMTP_SERVER=your-smtp-server

# Application Settings
WORKERS=4  # Number of Gunicorn workers for production
THREADS=2  # Number of threads per worker

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Security Settings
BCRYPT_LOG_ROUNDS=12
JWT_SECRET_KEY=your-jwt-secret-key
JWT_EXPIRATION_HOURS=24

# Features Toggle
ENABLE_REGISTRATION=True
ENABLE_EMAIL_VERIFICATION=False
ENABLE_TWO_FACTOR_AUTH=False

# Deployment Platform (Leave as is, will be set by platform)
# HEROKU=False
# RAILWAY=False
# AWS=False
